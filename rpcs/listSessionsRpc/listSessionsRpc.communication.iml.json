{
    "url": "/sessions",
    "method": "GET",
    "qs": {
        "limit": "100"
    },
    "response": {
        "iterate": "{{body.data}}",
        "output": {
            "label": "{{item.title}}",
            "value": "{{item.sessionId}}"
        },
        "limit": 300
    },
    "pagination": {
        "qs": {
            "after": "{{body.pagination.next}}"
        },
        "condition": "{{body.pagination.hasMore}}"
    }
}
